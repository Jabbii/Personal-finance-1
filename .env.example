# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# --- BROWSER-SAFE (NEXT_PUBLIC_ prefix is fine) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- SERVER ONLY — never add NEXT_PUBLIC_ prefix to these ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
OPENROUTER_API_KEY=your-openrouter-key-here

# Model config (swap without code changes)
MODEL_PRIMARY=google/gemini-2.5-flash-lite
MODEL_FALLBACK=google/gemini-2.5-flash
MODEL_ANALYSIS=anthropic/claude-opus-4-7

# Sync script settings
ONEDRIVE_SLIP_PATH=C:\Users\YourName\OneDrive\Bank Slips
MAX_FILES_PER_RUN=100
DAILY_SPEND_LIMIT_USD=1.00

# Alerts (Phase 4 — leave blank to skip)
PUSHOVER_TOKEN=
PUSHOVER_USER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
